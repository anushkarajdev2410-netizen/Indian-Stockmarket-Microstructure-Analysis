ITIGNORE
# ============================================================
# .gitignore
# Indian Stock Market Microstructure Analysis — Capstone Project
# ============================================================
 
# ---------------------------------------------------------
# Python
# ---------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/
 
# ---------------------------------------------------------
# Jupyter / IPython
# ---------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py
 
# ---------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
 
# ---------------------------------------------------------
# Data files
# ---------------------------------------------------------
# Raw/processed market data can be regenerated at any time via the yfinance
# download cell in the notebook — no need to version-control it, and it keeps
# the repo lightweight. Keep the folders themselves tracked via .gitkeep.
data/raw/*.csv
data/raw/*.xlsx
data/processed/*.csv
data/processed/*.xlsx
!data/raw/.gitkeep
!data/processed/.gitkeep
 
# Also ignore stray data files if accidentally saved to the repo root
*.csv
 
# ---------------------------------------------------------
# Exported charts / report artifacts (regenerate from the notebook)
# ---------------------------------------------------------
images/*.png
images/*.jpg
!images/.gitkeep
 
# ---------------------------------------------------------
# OS-specific files
# ---------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
 
# ---------------------------------------------------------
# IDE / editor files
# ---------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
 
# ---------------------------------------------------------
# Logs and environment secrets
# ---------------------------------------------------------
*.log
.env
.env.local
 
# ---------------------------------------------------------
# Miscellaneous
# ---------------------------------------------------------
.cache/
.pytest_cache/